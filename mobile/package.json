    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@scure/bip39": "^2.4.0",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-argon2": "^4.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:crypto": "tsx scripts/crypto-compat.ts",
    "android:prepare": "node scripts/patch-argon2.mjs && node scripts/patch-android.mjs",
    "android:keystore": "bash scripts/setup-keystore.sh",
    "apk:release": "bash scripts/build-apk.sh",
    "seed:test": "tsx scripts/seed-test-account.ts",
    "postinstall": "node scripts/patch-argon2.mjs",
    "lint": "expo lint"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-render-html",
          "react-native-argon2"
        ]
      }
    }
  }
